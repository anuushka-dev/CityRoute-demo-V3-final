# ==============================================================================
# CityRoute Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and customize coordinates, graph paths, API keys,
# Redis settings, and solver optimization parameters as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & City Branding
# ------------------------------------------------------------------------------
CITYROUTE_APP_NAME=CityRoute
CITYROUTE_ENVIRONMENT=development
CITYROUTE_CITY_NAME="Kanpur, Uttar Pradesh, India"
CITYROUTE_CITY_SHORT_NAME="Kanpur Central"
CITYROUTE_LOG_LEVEL=INFO
CITYROUTE_SERVE_FRONTEND=true
CITYROUTE_FRONTEND_DIST_DIR=frontend/dist

# ------------------------------------------------------------------------------
# 2. Security, API Keys & Map Tile Provider
# ------------------------------------------------------------------------------
# Optional API key to protect backend endpoints (leave blank to allow open demo access)
CITYROUTE_API_KEY=
# Optional external geocoding / routing API key (for custom integrations)
CITYROUTE_EXTERNAL_ROUTING_API_KEY=
# Optional map tile provider API key (e.g., Mapbox, MapTiler, Stadia, Thunderforest)
CITYROUTE_MAP_API_KEY=
# Leaflet raster tile template URL
CITYROUTE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
CITYROUTE_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
CITYROUTE_CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Road Graph & Geographic Coordinates (Latitude / Longitude / Bounding Box)
# ------------------------------------------------------------------------------
CITYROUTE_DATA_DIR=data
CITYROUTE_GRAPH_DIR=data/graphs
CITYROUTE_GRAPH_FILE=kanpur_central.graphml
CITYROUTE_USE_BBOX_GRAPH=true

# Bounding box coordinates for valid map selection & graph generation
CITYROUTE_BBOX_NORTH=26.50
CITYROUTE_BBOX_SOUTH=26.43
CITYROUTE_BBOX_EAST=80.38
CITYROUTE_BBOX_WEST=80.28

# Default map center latitude, longitude, zoom, and fallback road speed
CITYROUTE_DEFAULT_CENTER_LAT=26.465
CITYROUTE_DEFAULT_CENTER_LON=80.33
CITYROUTE_DEFAULT_ZOOM=13
CITYROUTE_DEFAULT_SPEED_KPH=30.0

# ------------------------------------------------------------------------------
# 4. Redis Cache & Resilience Configuration
# ------------------------------------------------------------------------------
# Use redis://localhost:6379/0 for a local/Docker Redis instance, or memory://
# for pure in-memory caching. When CITYROUTE_REDIS_IN_MEMORY_FALLBACK=true,
# CityRoute automatically activates a thread-safe in-memory Redis cache if the
# TCP Redis server is unreachable so Redis caching works out of the box.
CITYROUTE_REDIS_URL=redis://localhost:6379/0
CITYROUTE_REDIS_SOCKET_TIMEOUT_S=1.5
CITYROUTE_REDIS_IN_MEMORY_FALLBACK=true
CITYROUTE_REDIS_FAIL_OPEN=true
CITYROUTE_READINESS_REQUIRE_REDIS=false
CITYROUTE_REDIS_RECOVERY_ENABLED=true
CITYROUTE_REDIS_RECOVERY_INTERVAL_S=2.0
CITYROUTE_REDIS_MAX_RECOVERY_INTERVAL_S=30.0
CITYROUTE_REDIS_RECOVERY_BACKOFF_MULTIPLIER=2.0
CITYROUTE_REDIS_HEALTHCHECK_INTERVAL_S=15.0

# ------------------------------------------------------------------------------
# 5. Distance Matrix Optimization
# ------------------------------------------------------------------------------
CITYROUTE_MATRIX_CACHE_TTL_SECONDS=86400
CITYROUTE_MATRIX_MAX_LOCATIONS=25
CITYROUTE_MATRIX_WORKERS=4

# ------------------------------------------------------------------------------
# 6. VRP / Delivery Stop Optimization (Greedy, 2-Opt, LNS)
# ------------------------------------------------------------------------------
CITYROUTE_VRP_MAX_STOPS=24
CITYROUTE_VRP_DEFAULT_MATRIX_ALGORITHM=bidirectional_astar
CITYROUTE_VRP_DEFAULT_USE_CACHE=true
CITYROUTE_TWO_OPT_MAX_ITERATIONS=100
CITYROUTE_TWO_OPT_IMPROVEMENT_TOLERANCE_M=0.000001
CITYROUTE_LNS_MAX_ITERATIONS=350
CITYROUTE_LNS_DESTROY_FRACTION=0.35
CITYROUTE_LNS_NO_IMPROVEMENT_LIMIT=60
CITYROUTE_LNS_RANDOM_SEED=42

# ------------------------------------------------------------------------------
# 7. Dispatch Optimization (Greedy vs Optimal Hungarian)
# ------------------------------------------------------------------------------
CITYROUTE_DISPATCH_DEFAULT_MATRIX_ALGORITHM=haversine
CITYROUTE_DISPATCH_DEFAULT_USE_CACHE=true
CITYROUTE_DISPATCH_CACHE_TTL_SECONDS=86400
CITYROUTE_DISPATCH_UNREACHABLE_COST_M=1000000000.0
CITYROUTE_DISPATCH_DEFAULT_LOAD_PENALTY_M=0.0
CITYROUTE_DISPATCH_DEFAULT_SLOT_PENALTY_M=0.0
CITYROUTE_DISPATCH_DEFAULT_DRIVER_CAPACITY=4

# ------------------------------------------------------------------------------
# 8. Operations Pipeline Defaults (Dispatch -> VRP -> Route Legs)
# ------------------------------------------------------------------------------
CITYROUTE_OPERATIONS_DEFAULT_VRP_STRATEGY=lns
CITYROUTE_OPERATIONS_DEFAULT_VRP_MATRIX_ALGORITHM=source_dijkstra
CITYROUTE_OPERATIONS_DEFAULT_DISPATCH_MATRIX_ALGORITHM=haversine
CITYROUTE_OPERATIONS_DEFAULT_RETURN_TO_START=false

# ------------------------------------------------------------------------------
# 9. Concurrency, Admission Control, Timeouts & Graceful Shutdown
# ------------------------------------------------------------------------------
CITYROUTE_CONCURRENCY_MAX_ACTIVE_REQUESTS=4
CITYROUTE_CONCURRENCY_MAX_WAITING_REQUESTS=8
CITYROUTE_CONCURRENCY_WAIT_TIMEOUT_S=0.25
CITYROUTE_CONCURRENCY_RETRY_AFTER_S=1
CITYROUTE_LIFECYCLE_RETRY_AFTER_S=1

CITYROUTE_ROUTE_TIMEOUT_S=5.0
CITYROUTE_ROUTE_COMPARE_TIMEOUT_S=10.0
CITYROUTE_MATRIX_TIMEOUT_S=15.0
CITYROUTE_VRP_TIMEOUT_S=20.0
CITYROUTE_ADVANCED_VRP_TIMEOUT_S=30.0
CITYROUTE_DISPATCH_TIMEOUT_S=20.0
CITYROUTE_OPERATIONS_TIMEOUT_S=45.0
CITYROUTE_REQUEST_TIMEOUT_CANCELLATION_GRACE_S=0.05
CITYROUTE_EMIT_TIMEOUT_HEADERS=true

CITYROUTE_SHUTDOWN_DRAIN_TIMEOUT_S=5.0
CITYROUTE_SHUTDOWN_POLL_INTERVAL_S=0.05
CITYROUTE_SHUTDOWN_CLOSE_REDIS=true
